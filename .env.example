# --- Required ---
DATABASE_URL=postgresql://neondb_owner:npg_a2KV0gfiqwIF@ep-young-violet-b5sc0v5q-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require            # Neon URL, must end with ?sslmode=require
SESSION_SECRET=random_secret         # long random string (also derives the token-encryption key; changing it invalidates stored tokens)
# --- First-run admin (created once if missing) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123#
# --- App ---
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:5173      # dev: Vite URL. Production: your public https URL
TICK_SECRET=                       # optional: enables POST /internal/tick for external schedulers
WORKER_INTERVAL_SECONDS=15

# --- Meta (Instagram Login) - needed to connect accounts ---
META_APP_ID=
META_APP_SECRET=
# Must match EXACTLY what you add in the Meta dashboard
META_REDIRECT_URI=http://localhost:3001/api/ig/callback

META_GRAPH_API_VERSION=v21.0
META_SCOPES=instagram_business_basic,instagram_business_content_publish
# --- Cloudflare R2 (optional; without it uploads use local ./tmp-uploads, which Instagram cannot fetch unless APP_URL is public) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=                       # optional, defaults to https://<account>.r2.cloudflarestorage.com
